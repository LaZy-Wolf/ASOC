# Copy to .env and fill in. .env is gitignored.

GROQ_API_KEY=gsk_xxxxxxxxx
GROQ_API_KEY2=gsk_xxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxx

QDRANT_URL=http://localhost:6333

# Created in the Langfuse UI (http://localhost:3001) after `docker compose up`.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://localhost:3001

# Local-only secrets for the self-hosted Langfuse container. Generate your own:
#   py -3.12 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
NEXTAUTH_SECRET=
LANGFUSE_SALT=
